<wml version="1">
  <Window Name="main" Title="wml with the new controls" InnerSize="640,420">
    <Button Name="save" Text="Save" Kind="Split" Default="true" Bounds="10,10,120,28" OnClick="onSave"/>
    <CheckBox Text="Three state" ThreeState="true" PushLike="false" Bounds="140,12,130,22"/>
    <EditLine Name="num" NumbersOnly="true" TextAlign="Right" Bounds="280,12,80,24" OnFocus="onFocus"/>
    <ComboBox Editable="true" Bounds="370,12,120,24" OnTextChange="onText">
      <Item>red</Item><Item>green</Item><Item>blue</Item>
    </ComboBox>
    <ProgressBar Name="bar" State="Paused" Value="0.4" Bounds="500,12,130,22"/>

    <ListView Name="list" Bounds="10,50,300,200" Sortable="true" CheckBoxes="true" MultiSelect="true"
              OnSelect="onSelect" OnActivate="onActivate">
      <Column>Name</Column><Column>Type</Column>
      <Item>alpha</Item><Item>beta</Item><Item>gamma</Item>
    </ListView>

    <RichEdit Name="rich" Text="Rich text with a link: https://example.com" Bounds="320,50,310,200"
              OnLinkClick="onLink"/>

    <LinkLabel Text="Open &lt;a href=&quot;https://github.com&quot;&gt;GitHub&lt;/a&gt;" Bounds="10,260,300,22"/>
    <MonthCalendar Bounds="10,290,230,125" OnChange="onDate"/>
    <HotKeyEdit Bounds="250,290,150,24"/>
    <IPAddressEdit Bounds="250,322,150,24"/>
    <ImageView Mode="Fit" BackColor="#dde" Bounds="420,260,210,150"/>

    <ScrollPanel Name="scroll" Bounds="250,355,150,60" BackgroundColor="#fff">
      <Label Text="first"  Bounds="4,4,100,18"/>
      <Label Text="second" Bounds="4,40,100,18"/>
      <Label Text="third"  Bounds="4,80,100,18"/>
    </ScrollPanel>
  </Window>
</wml>
